#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

PHP_BIN="php"
if ! command -v php >/dev/null 2>&1; then
  if [ -f "/c/ServBay/bin/php.cmd" ]; then
    PHP_BIN="/c/ServBay/bin/php.cmd"
  fi
fi

# PHPUnit tests
echo "→ PHPUnit..."
"$PHP_BIN" artisan test --parallel --stop-on-failure
if [ $? -ne 0 ]; then
  echo "❌ PHPUnit tests failed!"
  exit 1
fi
echo "✅ PHPUnit passed"

# Playwright smoke tests (chỉ chạy nếu có APP_URL)
if [ -n "$RUN_E2E_ON_PUSH" ]; then
  echo "→ Playwright smoke tests..."
  npm run test:e2e:smoke
  if [ $? -ne 0 ]; then
    echo "❌ Playwright smoke tests failed!"
    exit 1
  fi
  echo "✅ Playwright smoke tests passed"
fi

echo "✅ All pre-push checks passed!"
