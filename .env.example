APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_EMAIL_DOMAINS=
# Chỉ dùng khi InvalidState không hết và chấp nhận OAuth không check state (OAuth stateless — kém CSRF).
# GOOGLE_OAUTH_STATELESS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# CMS (cms_db_staging) — same server/user as DB_* unless overridden
CMS_DB_DATABASE=cms_db_staging
# CMS_DB_HOST=
# CMS_DB_PORT=
# CMS_DB_USERNAME=
# CMS_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Local: sync = job chạy ngay trong request, không cần queue:work.
# Production: đặt redis (khuyến nghị) hoặc database — lúc đó mới cần queue:work và job mới vào Redis/bảng jobs.
# Worker treo chỉ hiện "Processing jobs..." = đang chờ job (bình thường); gán thử xe rồi xem có dòng PROCESSING.
# DATABASE: chạy migrate (có bảng jobs) trước khi QUEUE_CONNECTION=database.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Đặt đúng host ví dụ `.vaschools.edu.vn` hoặc để trống khi chỉ có một subdomain cố định.
# Sai SESSION_DOMAIN ⇒ mất cookie session ⇒ Google OAuth báo InvalidStateException.
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
#
# OAuth Google: Laravel mặc định tin proxy (trusted_proxies); override .env: TRUSTED_PROXIES= để tắt hoặc liệt kê IP.
# Sai cookie session ⇒ InvalidStateException. Prod https: APP_URL phải https.
# Fallback (kém CSRF protection): GOOGLE_OAUTH_STATELESS=true

# Web Push (PWA) — tạo key: npx --yes web-push generate-vapid-keys
# VAPID_SUBJECT: mailto: hoặc https URL (theo chuẩn web-push)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Queue tên thông báo điều vận (TripAssignedNotification, …). Phải khớp supervisor/Horizon.
# DISPATCH_NOTIFICATIONS_QUEUE_DEFAULT=default
# DISPATCH_NOTIFICATIONS_QUEUE_URGENT=urgent-notifications
# DISPATCH_MAIL_HELPDESK=
# DISPATCH_DEPT_APPROVAL_REMIND_AFTER_HOURS=24
# DISPATCH_SIGNED_PAPER_REMIND_AFTER_HOURS=24
# DISPATCH_PRICING_SUGGEST_ENABLED=true
# DISPATCH_OCR_USE_QUEUE=false

# Log debug luồng thông báo tài xế + Web Push (mặc định theo APP_DEBUG)
# DISPATCH_DEBUG_NOTIFICATION_LOG=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
# Frontend (Vite dev server) trỏ Laravel để URL /storage đúng server (khi chạy `npm run dev` + `php artisan serve`).
# VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Driver PWA — số phòng mua hàng để cập nhật giấy tờ / ảnh (`/driver/account`, liên kết `tel:`)
# VITE_PROCUREMENT_PHONE=
